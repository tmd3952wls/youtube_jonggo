# 비밀 키 (각자 .env.example 을 복사해 채움)
.env
*.key

# 가상환경 / 캐시
.venv*/
__pycache__/
*.pyc

# 외부에서 받은 저장소 (README 의 설치 순서로 각자 받음)
ext/

# 작업 폴더의 영상·음성·이미지 (원본 방송 영상 저작권 + 용량). EDL·대본·고정댓글 같은 글만 올림
jobs/**/edl_tmp/
jobs/**/*.mp4
jobs/**/*.wav
jobs/**/*.mp3
jobs/**/*.m4a
jobs/**/*.webm
jobs/**/*.mkv
jobs/**/*.jpg
jobs/**/*.png
jobs/**/*.npz
jobs/**/*.out
jobs/**/*.log

# 배경음악 (라이선스 별도)
assets/bgm/*

# 로그
*.log

# Playwright MCP 스냅샷
.playwright-mcp/

# 효과음 믹스 중간 파일
jobs/**/sfx_level_tmp/
*.f32
