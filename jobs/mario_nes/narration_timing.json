[
  {
    "text": "미개봉 마리오 게임",
    "start": 0.0,
    "end": 0.934,
    "method": "whisperx",
    "prop_start": 0.0,
    "seg_start": 0.0,
    "seg_end": 1.808
  },
  {
    "text": "하나에 14억 원?",
    "start": 0.934,
    "end": 1.808,
    "method": "whisperx",
    "prop_start": 0.623,
    "seg_start": 0.0,
    "seg_end": 1.808
  },
  {
    "text": "그 시절 아이들이 열광하던 바로 그 마리오",
    "start": 5.645,
    "end": 7.857,
    "method": "whisperx",
    "prop_start": 5.645,
    "seg_start": 5.645,
    "seg_end": 7.857
  },
  {
    "text": "릭이 첨리를 불러 살펴보는데",
    "start": 7.857,
    "end": 9.457,
    "method": "whisperx",
    "prop_start": 7.857,
    "seg_start": 7.857,
    "seg_end": 9.457
  },
  {
    "text": "얼마를 원하냐고 묻자",
    "start": 13.77,
    "end": 15.103,
    "method": "whisperx",
    "prop_start": 13.77,
    "seg_start": 13.77,
    "seg_end": 15.103
  },
  {
    "text": "결국 릭은 와타",
    "start": 18.137,
    "end": 19.097,
    "method": "whisperx",
    "prop_start": 18.137,
    "seg_start": 18.137,
    "seg_end": 20.318
  },
  {
    "text": "감정사를 부르는데",
    "start": 19.097,
    "end": 20.318,
    "method": "whisperx",
    "prop_start": 19.163,
    "seg_start": 18.137,
    "seg_end": 20.318
  },
  {
    "text": "1985년 시험",
    "start": 27.218,
    "end": 28.191,
    "method": "whisperx",
    "prop_start": 27.218,
    "seg_start": 27.218,
    "seg_end": 29.263
  },
  {
    "text": "출시판이라는데",
    "start": 28.191,
    "end": 29.263,
    "method": "whisperx",
    "prop_start": 28.612,
    "seg_start": 27.218,
    "seg_end": 29.263
  },
  {
    "text": "그럼 경매가는",
    "start": 32.863,
    "end": 33.662,
    "method": "whisperx",
    "prop_start": 32.863,
    "seg_start": 32.863,
    "seg_end": 34.608
  },
  {
    "text": "얼마냐고 묻자",
    "start": 33.662,
    "end": 34.608,
    "method": "whisperx",
    "prop_start": 33.722,
    "seg_start": 32.863,
    "seg_end": 34.608
  },
  {
    "text": "이에 릭이 흥정을",
    "start": 39.041,
    "end": 39.934,
    "method": "whisperx",
    "prop_start": 39.041,
    "seg_start": 39.041,
    "seg_end": 40.741
  },
  {
    "text": "시작하는데",
    "start": 39.934,
    "end": 40.741,
    "method": "whisperx",
    "prop_start": 40.125,
    "seg_start": 39.041,
    "seg_end": 40.741
  },
  {
    "text": "결국 거래는",
    "start": 48.478,
    "end": 49.236,
    "method": "whisperx",
    "prop_start": 48.478,
    "seg_start": 48.478,
    "seg_end": 50.378
  },
  {
    "text": "그대로 불발됐고",
    "start": 49.236,
    "end": 50.378,
    "method": "whisperx",
    "prop_start": 49.283,
    "seg_start": 48.478,
    "seg_end": 50.378
  },
  {
    "text": "이 마리오의 뒷이야기는",
    "start": 51.678,
    "end": 52.697,
    "method": "whisperx",
    "prop_start": 51.678,
    "seg_start": 51.678,
    "seg_end": 54.878
  },
  {
    "text": "고정댓글에 있다",
    "start": 52.697,
    "end": 54.878,
    "method": "whisperx",
    "prop_start": 52.877,
    "seg_start": 51.678,
    "seg_end": 54.878
  }
]